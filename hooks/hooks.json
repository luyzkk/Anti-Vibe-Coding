{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '[Anti-Vibe-Coding 8.0]\\nFeature nova ou mudança grande: comece por /anti-vibe-coding:write-prd.\\nTarefa pequena: diga o objetivo, como verificar e quanto esforço.\\nDinheiro, saúde ou dados pessoais: aprove os cenários de teste antes do código.\\nDecisão de arquitetura, system design ou segurança: peça as perguntas e as opções.\\n'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"try{require(process.env.CLAUDE_PLUGIN_ROOT+'/hooks/tdd-gate.cjs')}catch(e){process.exit(0)}\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"try{require(process.env.CLAUDE_PLUGIN_ROOT+'/hooks/tdd-gate-bash.cjs')}catch(e){process.exit(0)}\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"try{require(process.env.CLAUDE_PLUGIN_ROOT+'/hooks/pre-tool-use-destructive-guard.cjs')}catch(e){process.exit(0)}\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"try{require(process.env.CLAUDE_PLUGIN_ROOT+'/hooks/pre-commit-suite.cjs')}catch(e){process.exit(0)}\"",
            "timeout": 90
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"try{require(process.env.CLAUDE_PLUGIN_ROOT+'/hooks/stop-reflector.cjs').run().catch(function(){process.exit(0)})}catch(e){process.exit(0)}\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
