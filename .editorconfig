# 2026-08-18 (Luiz/dev): prevencao "Imediato" de docs/compound/2026-05-19-crlf-breaks-frontmatter-regex.md,
# capturada em 2026-05-19 mas nunca aplicada. Markdown salvo com CRLF no Windows quebrava, em silencio,
# todo parser de frontmatter do plugin. Os parsers agora normalizam; isto impede o CRLF de nascer.
# .gitattributes cobre fixtures/husky/*.sh no commit — este arquivo cobre o editor, antes do commit.
root = true

[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Markdown usa dois espacos no fim da linha como quebra explicita.
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
